{
  "productName": "AI Gaming Companion",
  "version": "0.2.0",
  "identifier": "com.ai-game-overlay.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "config",
        "title": "AI Gaming Companion",
        "width": 480,
        "height": 640,
        "center": true,
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": false,
        "resizable": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
